# ═══════════════════════════════════════════════════════════════════════════
#  Papercub — local environment
#
#  Gitignored. Paste real values here; never commit it.
#  Sections are ordered so each one unlocks something on its own — you do NOT
#  need to fill the whole file to make progress.
#
#  STEP 1  Supabase       -> the app talks to a real backend
#  STEP 2  Gemini         -> stories actually generate  ← the big one
#  STEP 3  RevenueCat     -> purchases work
#  STEP 4  Apple + Google -> real sign-in, device builds, TestFlight
#
#  Anything left blank degrades gracefully: the app falls back to mock data and
#  still runs in Expo Go.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  STEP 1 — SUPABASE          Unlocks: real database, auth, storage
#  Time: ~5 min · Cost: free tier is fine
#
#  1. https://supabase.com/dashboard -> New project (pick an EU region — the
#     product is EU-first and this keeps child data in-region)
#  2. Project Settings -> Data API  -> copy Project URL and the anon key
#  3. Project Settings -> Database  -> copy the connection string
#  4. Then push the schema:
#       npx supabase link --project-ref <ref>
#       npx supabase db push
# ───────────────────────────────────────────────────────────────────────────

# Safe to ship inside the app binary. Protected by RLS, not by secrecy.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=

# ⚠️  BYPASSES ALL ROW-LEVEL SECURITY. Read only by services/worker.
#     ESLint fails the build if this string appears anywhere else.
#     Project Settings -> Data API -> service_role ("Reveal")
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI (pooler, port 6543)
SUPABASE_DB_URL=

# https://supabase.com/dashboard/account/tokens  (only needed for CI)
SUPABASE_ACCESS_TOKEN=


# ───────────────────────────────────────────────────────────────────────────
#  STEP 2 — GEMINI           Unlocks: real story generation
#  Time: ~2 min · Cost: pay-as-you-go, ~$0.45–0.74 per story
#
#  https://aistudio.google.com/apikey
#
#  ⚠️  Use a PAID (billing-enabled) key, not the free tier. Free consumer tiers
#      generally do NOT contractually disclaim training on your inputs, and
#      those inputs are children's drawings. This is a privacy requirement,
#      not a rate-limit one — see DECISIONS.md §10 and PLAN.html §8.
#
#  ⚠️  DECISIONS.md §14: the worker's price table is still PLACEHOLDER, derived
#      from the cost model rather than read off real pricing. The first real
#      generation is when the §11 economics stop being an estimate — check the
#      measured cost/story against $0.45 / $0.64 / $0.74 before trusting them.
# ───────────────────────────────────────────────────────────────────────────

GEMINI_API_KEY=

# Model ids have sensible defaults in services/worker/src/config.ts — override
# only if you know why. Verify these against current model availability.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL_PREMIUM=gemini-2.5-flash-image        # cover only
# GEMINI_IMAGE_MODEL_FAST=gemini-2.5-flash-lite-image      # interior pages
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional second provider, implemented but dark. https://platform.openai.com/api-keys
OPENAI_API_KEY=
ENABLE_OPENAI_PROVIDER=


# ───────────────────────────────────────────────────────────────────────────
#  STEP 3 — REVENUECAT       Unlocks: subscriptions and top-ups
#  Time: ~15 min · Cost: free under $2.5k/mo tracked revenue, then ~1%
#  ⚠️  Requires Apple Developer (Step 4) — products live in App Store Connect.
#
#  1. https://app.revenuecat.com -> new project -> add an App Store app
#  2. Create products matching DECISIONS.md §1 exactly:
#       papercub_family_monthly   EUR  7.99
#       papercub_family_annual    EUR 79.99
#       papercub_topup_3          EUR  4.99   (consumable)
#  3. API keys -> Apple App Store  -> public SDK key (below)
#  4. Integrations -> Webhooks:
#       URL:  https://<project-ref>.supabase.co/functions/v1/revenuecat-webhook
#       Auth header value: whatever you set as REVENUECAT_WEBHOOK_SECRET
#
#  ⚠️  react-native-purchases is NOT installed yet:
#       cd apps/mobile && npx expo install react-native-purchases
# ───────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# The webhook rejects any request whose Authorization header does not match
# this, BEFORE parsing the body. Generate one: openssl rand -hex 32
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat -> API keys -> Secret key (v2). Worker-only.
# The worker re-fetches subscriber state with this rather than trusting the
# webhook payload, which is what makes a forged inbox row harmless.
REVENUECAT_SECRET_API_KEY=


# ───────────────────────────────────────────────────────────────────────────
#  STEP 4 — APPLE + GOOGLE   Unlocks: real sign-in, device builds, TestFlight
#  See APPLE_SETUP.md for why and exactly how.
# ───────────────────────────────────────────────────────────────────────────

APPLE_BUNDLE_ID=

# developer.apple.com -> Membership details -> Team ID (needs paid enrolment)
APPLE_TEAM_ID=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 client IDs
# Create BOTH an iOS client and a Web client. The Web client id is the audience
# Supabase validates against, so it is the one that matters most.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# expo.dev -> Project -> Project ID (only needed for EAS builds)
EAS_PROJECT_ID=
# expo.dev -> Account settings -> Access tokens (CI only)
EXPO_TOKEN=


# ───────────────────────────────────────────────────────────────────────────
#  WORKER RUNTIME — safe defaults, change deliberately
# ───────────────────────────────────────────────────────────────────────────

WORKER_ENV=
WORKER_CONCURRENCY=

# DECISIONS.md §3.3 — the last backstop above every per-account limit.
# 50000 = $500/day. Generation halts entirely when breached.
# ⚠️  Review finding 8: this currently sums rows client-side and PostgREST caps
#     at 1000 rows, so past 1000 jobs/day the halt silently stops working.
GLOBAL_DAILY_SPEND_CAP_CENTS=

# Pins which model set produced a story, so an old story stays explainable.
MODEL_BUNDLE_VERSION=

# Shared secrets between our own services. openssl rand -hex 32
WORKER_INTERNAL_SECRET=
MERGE_TOKEN_SECRET=

# Kill switch. Set to true to stop all generation without a deploy.
GENERATION_HALTED=

# fly.io -> Account -> Access tokens (only for deploying the worker)
FLY_API_TOKEN=
