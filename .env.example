# Copy to .env (mobile) and services/worker/.env as appropriate.
# Never commit a real .env — see .gitignore.

# ── Supabase — public, safe to ship in the mobile bundle ────────────────────
# Both from: Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase — secret, worker only. NEVER reference outside services/worker ─
# Full-database-bypass key. From: Supabase Dashboard → Project Settings → API
# → "service_role" secret. Read only by services/worker/src/config.ts.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string. From: Supabase Dashboard → Project
# Settings → Database → Connection string (URI, "Use connection pooling: no"
# for migrations).
SUPABASE_DB_URL=
# From: Supabase Dashboard → Project Settings → General → Reference ID.
SUPABASE_PROJECT_REF=
# From: Supabase Dashboard → Account → Access Tokens → Generate new token.
SUPABASE_ACCESS_TOKEN=

# ── AI providers — worker only ───────────────────────────────────────────────
# From: Google AI Studio / Google Cloud Console → API Keys.
# IMPORTANT: use a PAID tier key — consumer/free tiers do not contractually
# disclaim training on inputs, and this pipeline processes children's drawings.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL_PREMIUM=
GEMINI_IMAGE_MODEL_FAST=
GEMINI_TTS_MODEL=
# From: platform.openai.com → API keys. Optional fallback provider.
OPENAI_API_KEY=
# From: replicate.com → Account → API tokens. Optional fallback provider.
REPLICATE_API_TOKEN=

# ── RevenueCat ────────────────────────────────────────────────────────────
# From: RevenueCat Dashboard → Project → API Keys → Public app-specific key (iOS).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# From: RevenueCat Dashboard → Project → Integrations → Webhooks → Shared secret.
REVENUECAT_WEBHOOK_SECRET=
# From: RevenueCat Dashboard → Project → API Keys → Secret key (server-to-server).
REVENUECAT_SECRET_API_KEY=

# ── Apple ─────────────────────────────────────────────────────────────────
APPLE_BUNDLE_ID=com.papercub.app
# From: Apple Developer → Membership details → Team ID.
APPLE_TEAM_ID=

# ── Google ────────────────────────────────────────────────────────────────
# From: Google Cloud Console → APIs & Services → Credentials → OAuth client
# (iOS application type).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# From: Google Cloud Console → APIs & Services → Credentials → OAuth client
# (Web application type, used for the Supabase Google provider).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# ── Worker runtime ────────────────────────────────────────────────────────
# From: fly.io → Account → Access Tokens (flyctl auth token).
FLY_API_TOKEN=
WORKER_ENV=development
WORKER_CONCURRENCY=4
GLOBAL_DAILY_SPEND_CAP_CENTS=50000
# Shared secret for edge-function → worker (and worker → edge-function)
# server-to-server calls. Generate your own random value, e.g. `openssl rand -hex 32`.
WORKER_INTERNAL_SECRET=

# ── Expo ──────────────────────────────────────────────────────────────────
# From: expo.dev → Account Settings → Access Tokens.
EXPO_TOKEN=
# From: expo.dev → Project → Configuration → EAS Project ID (or `eas init`).
EAS_PROJECT_ID=
