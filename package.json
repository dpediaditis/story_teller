{
  "name": "papercub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "mobile": "pnpm --filter @papercub/mobile start",
    "worker:dev": "pnpm --filter @papercub/worker dev",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared/src/db.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.10.0",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0",
    "vitest": "^2.1.3",
    "@types/node": "^20.16.11"
  }
}
